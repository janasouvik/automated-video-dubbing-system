# ─── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:740789@localhost:5432/video_dubbing

# ─── Application ────────────────────────────────────────────────────────────────
APP_ENV=development          # development | production
DEBUG=true
SECRET_KEY=change-me-in-production-use-a-long-random-string

# ─── Storage Paths ───────────────────────────────────────────────────────────────
DATA_DIR=./data/jobs
MODELS_CACHE_DIR=./models_cache

# ─── Whisper ─────────────────────────────────────────────────────────────────────
# Options: tiny, base, small, medium, large, large-v2, large-v3
WHISPER_MODEL_SIZE=small
# Audio chunk duration in seconds for long videos (default: 600s = 10 min)
WHISPER_CHUNK_DURATION_SEC=600

# ─── Translation ──────────────────────────────────────────────────────────────────
# NLLB model: facebook/nllb-200-distilled-600M  (fast) or facebook/nllb-200-1.3B (better)
NLLB_MODEL_NAME=facebook/nllb-200-distilled-600M

# ─── TTS ──────────────────────────────────────────────────────────────────────────
# Default English edge-tts voices (used when gender cannot be detected)
TTS_DEFAULT_MALE_VOICE=en-US-GuyNeural
TTS_DEFAULT_FEMALE_VOICE=en-US-JennyNeural
# Max time-stretch factor via ffmpeg atempo (1.0 = no stretch, 2.0 = double speed)
TTS_MAX_STRETCH_FACTOR=2.0
TTS_MIN_STRETCH_FACTOR=0.5

# ─── Stretch Goals ────────────────────────────────────────────────────────────────
USE_DIARIZATION=false
USE_VOICE_CLONING=false

# ─── ffmpeg ───────────────────────────────────────────────────────────────────────
# Leave blank to use system ffmpeg; set path if installed in a custom location
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ─── Frontend ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
